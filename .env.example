# Copy this file to .env.local and fill in real values.
# .env.local is never committed — it's in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# ── Anthropic (Sprint 4 — AI Metadata) ───────────────────────────────────────
# Server-side only. No NEXT_PUBLIC_ prefix — never sent to the client bundle.
# Get your key at: https://console.anthropic.com/settings/keys
# Model used: claude-haiku-4-5-20251001
# Cost: ~$0.0004/call. Leave empty to disable AI suggestions gracefully.
ANTHROPIC_API_KEY=
